class Solution {
    public boolean halvesAreAlike(String s) {
        int count1 = 0;
        int count2 = 0;

        String vowels = "aeiouAEIOU";
        int half = s.length() / 2;

        for (int i = 0; i < half; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count1++;
            }

            if (vowels.indexOf(s.charAt(i + half)) != -1) {
                count2++;
            }
        }

        return count1 == count2;
    }
}